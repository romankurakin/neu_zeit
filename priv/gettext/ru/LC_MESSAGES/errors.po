msgid "must be less than %{number}"
msgstr "Введите значение меньше %{number}."

msgid "must be greater than %{number}"
msgstr "Введите значение больше %{number}."

msgid "must be less than or equal to %{number}"
msgstr "Введите значение не больше %{number}."

msgid "must be greater than or equal to %{number}"
msgstr "Введите значение не меньше %{number}."

msgid "must be equal to %{number}"
msgstr "Введите %{number}."

msgid "is read-only"
msgstr "Это значение нельзя изменить."

msgid "does not exist"
msgstr "Запись больше не существует. Выберите другую."

msgid "is not allowed for this component"
msgstr "Выберите допустимую аудиторию для этого вида занятий."

msgid "must be a Monday"
msgstr "Выберите понедельник."

msgid "must be on or after starts_on"
msgstr "Выберите дату не раньше начала семестра."

msgid "must be within the term"
msgstr "Выберите дату в пределах семестра."

msgid "must be on a teaching day"
msgstr "Выберите учебный день."

msgid "must fall on teaching days"
msgstr "Выберите даты, которые приходятся на учебные дни."

msgid "must be a non-empty list of week numbers"
msgstr "Выберите хотя бы одну учебную неделю."

msgid "must be inside the term week range"
msgstr "Выберите недели в пределах семестра."

msgid "has no start cell that fits the session duration"
msgstr "В этом профиле нет времени, в которое занятие поместится целиком."

msgid "availability and slot profile leave no valid start for this session"
msgstr "Нет времени, подходящего по доступности преподавателя и профилю. Проверьте оба ограничения."

msgid "must contain at least one allowed start"
msgstr "Выберите хотя бы одно время начала."

msgid "must contain a start cell that fits every assigned session duration"
msgstr "Разрешите время начала, в которое каждое назначенное занятие поместится целиком."

msgid "change conflicts with existing placements"
msgstr "Эти недели конфликтуют с размещёнными занятиями. Проверьте расписание."

msgid "must be a non-empty list of ids"
msgstr "Выберите хотя бы одну запись."

msgid "contains invalid ids"
msgstr "Проверьте выбор и повторите попытку."

msgid "contains unknown ids"
msgstr "Часть выбранных записей больше не существует. Обновите страницу и выберите заново."

msgid "must match plan and session term"
msgstr "План и занятие должны относиться к одному семестру."

msgid "or session_id does not exist"
msgstr "План или занятие больше не существует. Обновите страницу."

msgid "must match the session term"
msgstr "Выберите семестр, к которому относится занятие."

msgid "must belong to this term"
msgstr "Выберите занятие из этого семестра."

msgid "is read-only unless it is a draft"
msgstr "Создайте черновик, чтобы изменить расписание."

msgid "locked placements cannot be changed without unlocking"
msgstr "Открепите размещение перед изменением."

msgid "must be blank for cancellations"
msgstr "При отмене занятия оставьте поле пустым."

msgid "does not match any scheduled occurrence"
msgstr "На эту дату занятие не запланировано. Выберите дату из расписания."

msgid "is already removed from the schedule by an excluded date"
msgstr "Занятие уже исключено, поскольку дата отмечена как неучебная."

msgid "cells must be a list of day/slot maps"
msgstr "Не удалось прочитать выбранное время. Обновите страницу и выберите заново."

msgid "each cell must be a day/slot map"
msgstr "Не удалось прочитать выбранное время. Обновите страницу и выберите заново."

msgid "term must keep at least %{minimum} weeks; existing sessions or placements use week %{week}"
msgstr "Сохраните не менее %{minimum} учебных недель. Занятия используют неделю %{week}."

msgid "is outside the configured slot grid (1..%{slots})"
msgstr "Занятие должно целиком помещаться в учебный день. Интервалов в дне: %{slots}."

msgid "leaves no valid start for an existing session"
msgstr "Для одного из занятий нет допустимого времени начала. Проверьте его длительность и профиль времени."

msgid "active plans cannot be deleted; publish another plan for the term first"
msgstr "Сначала опубликуйте другой план семестра. После этого текущий план можно удалить."

msgid "session is placed in the active published plan"
msgstr "Занятие есть в опубликованном расписании. Удалить его нельзя."

msgid "session has active schedule exceptions; revert or delete them first"
msgstr "Перед удалением занятия отмените его разовые изменения."

msgid "The plan changed while the solver was running. Your edits were kept. Run the solver again."
msgstr "Расписание изменилось во время расчёта. Ваши правки сохранены. Запустите расчёт заново."

msgid "Remove placements before reducing this workload."
msgstr "Перед уменьшением нагрузки снимите лишние занятия с расписания."

msgid "The workload changed. Reload it before saving."
msgstr "Нагрузка изменилась. Откройте её заново перед сохранением."

msgid "A generated meeting must fall on a teaching date."
msgstr "Занятие должно проходить в учебную дату."

msgid "Hours must cover a whole number of sessions of this duration."
msgstr "Часы должны делиться на длительность занятия без остатка."

#
msgid "must be a non-empty list of weeks within the term"
msgstr "Выберите хотя бы одну учебную неделю семестра."

msgid "Changing this teaching load would delete session history. Keep the existing sessions."
msgstr "Изменение нагрузки удалит историю занятий. Сохраните существующие занятия."

msgid "Teaching load exceeds the available time."
msgstr "Нагрузка превышает доступное учебное время."

msgid "Edit teaching load instead of individual sessions."
msgstr "Измените учебную нагрузку. Занятия обновятся вместе с ней."

msgid "Teaching load and sessions differ. Run the scheduler again."
msgstr "Занятия не соответствуют учебной нагрузке. Запустите расчёт заново."

msgid "Remove placements before deleting this teaching load."
msgstr "Снимите размещения перед удалением учебной нагрузки."

msgid "This teaching load already exists. Edit its hours."
msgstr "Такая учебная нагрузка уже есть. Измените часы в существующей строке."

msgid "must be blank for teacher substitutions"
msgstr "при замене преподавателя это поле должно быть пустым"

msgid "is used by a one-off change"
msgstr "используется в разовом изменении"

msgid "This teaching type is used by courses. Remove it from those courses first."
msgstr "Этот вид занятий используется в предметах. Сначала удалите его из этих предметов."

msgid "Enter a name in at least one language."
msgstr "Укажите название хотя бы на одном языке."

msgid "Some sessions are unplaced. Confirm publication of this partial timetable."
msgstr "Не все занятия размещены. Подтвердите публикацию неполного расписания."

msgid "Teaching days must start on Monday and follow calendar order."
msgstr "Учебные дни должны идти подряд, начиная с понедельника."

msgid "Enter between 1 and 24 time slots."
msgstr "Укажите от 1 до 24 интервалов времени."

msgid "Enter a valid start and end time for every slot."
msgstr "Укажите начало и конец каждого интервала. Конец должен быть позже начала."

msgid "Time slots must be ordered and must not overlap."
msgstr "Расположите интервалы по времени и устраните пересечения."

msgid "Use the same duration for every time slot."
msgstr "Укажите одинаковую длительность для всех интервалов."

msgid "Time settings cannot change after teaching load, availability or time profiles have been entered."
msgstr "Нельзя изменить время после ввода нагрузки, доступности или профилей времени."

msgid "Choose a valid time zone."
msgstr "Выберите часовой пояс из списка."

msgid "must be blank for online sessions"
msgstr "Онлайн-занятию аудитория не нужна."

msgid "cannot change while the session has locked placements"
msgstr "Сначала снимите закрепление занятий в расписании."

msgid "cannot change because an archived plan preserves this session"
msgstr "Нельзя изменить формат занятия, сохранённого в архивном расписании. Создайте отдельную нагрузку."
