{
  "compilerOptions": {
    "paths": {
      "phoenix_live_view": ["../deps/phoenix_live_view"],
      "phoenix-colocated/*": ["./colocated/dev/*"],
      "@/*": ["./*"]
    },
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["js/**/*", "types/**/*.d.ts", "colocated/dev/**/*.js", "vendor/**/*"]
}
