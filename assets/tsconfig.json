{
  "compilerOptions": {
    "paths": {
      "phoenix": [
        "../node_modules/@types/phoenix"
      ],
      "phoenix_live_view": [
        "../deps/phoenix_live_view"
      ],
      "phoenix-colocated/*": [
        "./colocated/dev/*"
      ],
      "@/*": [
        "./*"
      ]
    },
    "allowJs": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "phoenix",
      "sortablejs",
      "node"
    ]
  },
  "include": [
    "js/**/*",
    "types/**/*.d.ts",
    "colocated/dev/**/*.js",
    "vendor/**/*"
  ]
}
